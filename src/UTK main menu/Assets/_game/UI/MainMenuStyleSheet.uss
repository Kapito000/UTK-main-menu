

.menuRegularButton {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/ChelaOne-Regular.ttf?fileID=12800000&guid=8c2226f5768e49f4ca5f58858a57cb7a&type=3#ChelaOne-Regular");
    font-size: 41px;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    background-image: url("project://database/Assets/UI/Textures/UI_atlas.psd?fileID=-4355731583856638786&guid=68de98d899585b7469e0fb40a0fcbc56&type=3#bt_08");
    width: 312px;
    height: 93px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.centerPanel {
    width: 567px;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.menuRegularButton:hover {
    scale: 1.05 1.05;
    transition-duration: 0.1s;
}
